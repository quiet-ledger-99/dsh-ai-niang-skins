--- a/patches-inkwhite.css
+++ b/patches-inkwhite.css
@@ -276,3 +276,76 @@
  [data-slot="sidebar"] [class*="_panelRow"]{height:33px;min-height:33px;margin-block:1px;padding-block:2px}
  [data-slot="sidebar"] [class*="_panelGlyph"]{width:24px!important;height:24px!important;min-width:24px;background-size:24px 24px!important}
 }
+
+
+
+
+/* Coding Bot 2026-11-01d: phone — roomy bright 会话列表 under 工作区 */
+@media (max-width:700px){
+  :is(button,span)[class*="_wide"]:has([data-slot="sidebar.brand.mark"]){
+    height:52px!important;min-height:52px!important;padding:8px 16px 10px!important
+  }
+  [data-slot="sidebar.brand.name"] svg{width:100px!important;max-width:100px}
+  [data-slot="sidebar"] [class*="_panelList"]{
+    flex:0 1 auto!important;max-height:32vh!important;overflow:auto!important;margin-bottom:2px
+  }
+  [data-slot="sidebar"] [class*="_panelRow"]{
+    box-sizing:border-box;height:32px;min-height:32px;margin:1px 8px;padding:2px 10px
+  }
+  [data-slot="sidebar"] [class*="_panelGlyph"]{
+    width:20px!important;height:20px!important;min-width:20px;background-size:20px 20px!important
+  }
+  [data-dsh-part="new-session"]{height:34px!important;min-height:34px!important;margin:2px 8px 4px!important}
+
+  [data-slot="sidebar.workspaces"]{
+    flex:1 1 auto!important;
+    min-height:48vh!important;
+    overflow:auto!important;
+    -webkit-overflow-scrolling:touch;
+    background:#f4f7faf5!important;
+    border:1px solid #30384133!important;
+    border-radius:10px;
+    margin:4px 6px 8px!important;
+    padding:6px 4px 10px!important;
+    opacity:1!important;
+    filter:none!important;
+  }
+  [data-slot="sidebar.workspaces"] *{opacity:1}
+  [data-slot="sidebar.workspaces"] [class*="_sectionLabel"]{
+    color:#243038!important;text-shadow:none!important
+  }
+  [data-slot="sidebar.workspaces"] [class*="_projectRow"],
+  [data-slot="sidebar.workspaces"] [class*="_sessionRow"]{
+    min-height:44px!important;
+    color:#151a20!important;
+    background:#fff!important;
+    border:1px solid #30384155!important;
+    border-radius:8px;
+    margin:4px 2px!important;
+    box-shadow:none!important;
+    pointer-events:auto!important;
+    filter:none!important
+  }
+  [data-slot="sidebar.workspaces"] [class*="_sessionRow"][aria-selected="true"]{
+    background:#dfe7f0!important;box-shadow:inset 3px 0 #303841!important
+  }
+  [data-slot="sidebar.workspaces"] [class*="_title"]{
+    color:#151a20!important;font-size:14.5px!important;
+    white-space:nowrap;overflow:hidden;text-overflow:ellipsis
+  }
+  /* If a project children wrapper was height-clamped, let it grow */
+  [data-slot="sidebar.workspaces"] [class*="_children"],
+  [data-slot="sidebar.workspaces"] [class*="_tree"],
+  [data-slot="sidebar.workspaces"] [class*="_list"]{
+    max-height:none!important;overflow:visible!important;min-height:0
+  }
+}
+body.dsh-remote-portrait [data-slot="sidebar.workspaces"]{
+  flex:1 1 auto!important;min-height:48vh!important;overflow:auto!important;
+  background:#f4f7faf5!important;opacity:1!important
+}
+body.dsh-remote-portrait [class*="_sidebarCol"]{opacity:1!important;filter:none!important}
+/* Kill accidental full-screen dimmers that block taps on the list */
+body.dsh-remote-portrait [class*="_sidebarCol"] ~ [class*="_scrim"],
+body.dsh-remote-portrait [class*="_sidebarCol"] ~ [class*="_dimmer"]{pointer-events:none!important}
